<Project Sdk="Microsoft.NET.Sdk">
  <!-- uwcheck: checks our port (dist\UW1\uw-new.exe) with the Underworld Editor's "Check in Underworld Exhumed"
       (O:\UltimaUnderworldEditorAvalonia, MIT, Karl Clinckspoor), headless. Build: tools\uwcheck\build.cmd.
       Run through dotnet.exe (uwcheck.cmd): a new unsigned exe is blocked by Defender's ASR rule. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <EditorSrc>O:\UltimaUnderworldEditorAvalonia\src</EditorSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EditorSrc)\UwEditor.Core\UwEditor.Core.csproj" />
  </ItemGroup>
</Project>
